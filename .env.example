# Setfarm runtime configuration
#
# Precedence is:
# 1. Real process environment
# 2. .env.local
# 3. .env
#
# Use .env for shared deployment defaults and .env.local for local machine overrides.

MC_INTERNAL_URL=http://127.0.0.1:3080
SETFARM_PG_URL=postgresql://postgres@localhost:5432/setfarm
# Shared, random, 32+ character write credential used only for Mission Control's
# canonical v3 project-transfer acknowledgement callback. Keep the same secret
# in Mission Control and Setfarm local/production environment files.
SETFARM_OPERATIONAL_WRITE_TOKEN=

PROJECTS_DIR=$HOME/projects
SETFARM_DIR=$HOME/.openclaw/setfarm
SETFARM_REPO_DIR=$HOME/.openclaw/setfarm-repo
SCRIPTS_DIR=$HOME/.openclaw/scripts
CLI_PATH=$HOME/.local/bin

SETFARM_DEPLOY_HOST=
SETFARM_DISABLE_DEPLOY=

# Canonical, existing source/config authorities denied to generated runtimes.
# V3 local deployment is typed not-deployable when either binding is absent.
SETFARM_SOURCE_ROOT=/Users/setrox/ai/setrox/setfarm
MISSION_CONTROL_CONFIG_ROOT=/Users/setrox/ai/setrox/mission-control

# Admission-only v3 sealed-runtime capacity. This release never garbage-collects
# seal roots automatically; crash orphans remain charged to the byte quota.
SETFARM_V3_SEAL_ROOT_QUOTA_BYTES=68719476736
SETFARM_V3_SEAL_MAX_COUNT=256
SETFARM_V3_SEAL_MIN_FREE_BYTES=2147483648
