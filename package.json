{
  "name": "setfarm",
  "version": "2.3.79",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "setfarm": "dist/cli/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/server/index.html dist/server/index.html && cp src/installer/compat-rules.json dist/installer/compat-rules.json && mkdir -p dist/installer/prompts && cp src/installer/prompts/*.md dist/installer/prompts/ && node scripts/copy-step-assets.mjs && chmod +x dist/cli/cli.js && node scripts/inject-version.js",
    "start": "node dist/cli/cli.js",
    "test": "node --import tsx --test tests/*.test.ts && npm run test:steps && npm run test:status && npm run test:scripts && npm run test:product-compiler && npm run test:execution-attempts && npm run test:findings && npm run test:evidence && npm run test:recovery && npm run test:evals",
    "test:product-compiler": "node --import tsx --test tests/product-compiler/*.test.ts",
    "test:execution-attempts": "node --import tsx --test tests/execution-attempts/*.test.ts",
    "test:findings": "node --import tsx --test tests/findings/*.test.ts",
    "test:evidence": "node --import tsx --test tests/evidence/*.test.ts",
    "test:recovery": "node --import tsx --test tests/recovery/*.test.ts",
    "test:evals": "node --import tsx --test tests/evals/*.test.ts",
    "eval:contracts": "node --import tsx src/evals/contract-replay.ts --fixtures evals/fixtures",
    "eval:convergence": "node --import tsx src/evals/convergence-runner.ts",
    "rehearse:node-toolchain-bootstrap": "node --import tsx scripts/rehearse-node-toolchain-provisioner-bootstrap-v2.ts",
    "rehearse:node-scaffold-environment": "node --import tsx scripts/rehearse-node-scaffold-execution-environment-v2.ts",
    "rehearse:node-scaffold-dependencies": "node --import tsx scripts/rehearse-node-scaffold-dependencies-v2.ts",
    "db:contract-spine:plan": "node --import tsx scripts/contract-spine-migrate.ts plan",
    "db:contract-spine:apply": "node --import tsx scripts/contract-spine-migrate.ts apply",
    "db:contract-spine:verify": "node --import tsx scripts/contract-spine-migrate.ts verify",
    "db:contract-spine:audit-current-authority-ledgers": "node --import tsx scripts/contract-spine-migrate.ts audit-current-authority-ledgers",
    "db:contract-spine:audit-artifact-batches": "node --import tsx scripts/contract-spine-migrate.ts audit-artifact-publication-batches",
    "db:contract-spine:audit-artifact-store-authority-ledger": "node --import tsx scripts/contract-spine-migrate.ts audit-artifact-store-authority-ledger",
    "db:contract-spine:audit-platform-release-store-records": "node --import tsx scripts/contract-spine-migrate.ts audit-platform-release-store-records",
    "db:contract-spine:rollback-30": "node --import tsx scripts/contract-spine-migrate.ts rollback-30-to-29",
    "db:contract-spine:rollback-29": "node --import tsx scripts/contract-spine-migrate.ts rollback-29-to-28",
    "db:contract-spine:rollback-28": "node --import tsx scripts/contract-spine-migrate.ts rollback-28-to-27",
    "db:contract-spine:rollback-27": "node --import tsx scripts/contract-spine-migrate.ts rollback-27-to-26",
    "db:contract-spine:rollback-26": "node --import tsx scripts/contract-spine-migrate.ts rollback-26-to-25",
    "db:contract-spine:rollback-25": "node --import tsx scripts/contract-spine-migrate.ts rollback-25-to-24",
    "db:contract-spine:rollback-24": "node --import tsx scripts/contract-spine-migrate.ts rollback-24-to-23",
    "db:contract-spine:rollback-23": "node --import tsx scripts/contract-spine-migrate.ts rollback-23-to-22",
    "db:contract-spine:rollback-22": "node --import tsx scripts/contract-spine-migrate.ts rollback-22-to-21",
    "db:contract-spine:rollback-21": "node --import tsx scripts/contract-spine-migrate.ts rollback-21-to-20",
    "db:contract-spine:rollback-20": "node --import tsx scripts/contract-spine-migrate.ts rollback-20-to-19",
    "artifacts:index:plan": "node --import tsx scripts/product-artifact-index.ts plan",
    "artifacts:index:bootstrap": "node --import tsx scripts/product-artifact-index.ts bootstrap",
    "artifacts:index:verify": "node --import tsx scripts/product-artifact-index.ts verify",
    "artifacts:index:recover": "node --import tsx scripts/product-artifact-index.ts recover",
    "contracts:mission-control:write": "node --import tsx scripts/mission-control-contract-artifacts.ts --write",
    "check:mission-control-contracts": "node --import tsx scripts/mission-control-contract-artifacts.ts --check",
    "test:steps": "node --import tsx scripts/run-isolated-postgres-tests.ts -- node --import tsx --test tests/steps/*.test.ts",
    "test:status": "node --import tsx scripts/run-isolated-postgres-tests.ts -- node --import tsx --test src/installer/status.test.ts",
    "test:scripts": "node --test scripts/__tests__/*.test.js",
    "check:version": "node scripts/check-version-contract.mjs",
    "check:english": "node scripts/check-english-contract.mjs",
    "check:paths": "node scripts/check-path-contract.mjs",
    "check:migration-digests": "node --import tsx scripts/check-contract-spine-migration-digests.ts --check",
    "prebuild": "node scripts/write-build-info.mjs --prepare && node scripts/check-version-contract.mjs && node scripts/check-english-contract.mjs && node scripts/check-path-contract.mjs && npm run check:migration-digests && npm run check:mission-control-contracts",
    "postbuild": "node scripts/write-build-info.mjs --finalize"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "parse5": "^8.0.1",
    "playwright": "^1.60.0",
    "postgres": "^3.4.8",
    "yaml": "^2.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "esbuild": "0.28.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
